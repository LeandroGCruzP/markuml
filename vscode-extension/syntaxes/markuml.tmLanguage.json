{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "MarkUML",
  "scopeName": "source.markuml",
  "patterns": [
    {
      "name": "comment.line.double-slash.markuml",
      "match": "^\\s*//.*$"
    },
    {
      "name": "markup.heading.1.markuml",
      "match": "^#\\s+.*$"
    },
    {
      "name": "markup.heading.2.markuml",
      "match": "^##\\s+.*$"
    },
    {
      "name": "keyword.operator.arrow.markuml",
      "match": "(-->>|->>|-->|->|--\\|>|\\.\\.\\|>|\\*--|o--)"
    },
    {
      "name": "keyword.control.markuml",
      "match": "\\b(participant|note|over|as)\\b"
    },
    {
      "name": "string.quoted.double.markuml",
      "begin": "\"",
      "end": "\""
    }
  ]
}
